{
  "manifest_version": 3,
  "name": "Whip Cowboy",
  "version": "0.4.1",
  "description": "A hand-drawn stick-figure cowboy who cracks his whip at your AI (Claude, ChatGPT, Gemini) while it generates.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Whip Cowboy",
    "default_popup": "chrome/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "core/util.js",
        "core/i18n.js",
        "core/sites.js",
        "core/config.js",
        "core/art.js",
        "core/crew.js",
        "core/figure.js",
        "core/creatures.js",
        "core/stage.js",
        "core/bubbles.js",
        "core/menu.js",
        "core/detector.js",
        "core/events.js",
        "core/sfx.js",
        "core/fx.js",
        "core/juice.js",
        "core/events/mega.js",
        "core/events/destroyer.js",
        "core/events/reinforce.js",
        "core/events/airstrike.js",
        "core/events/duel.js",
        "core/events/jurassic.js",
        "core/events/scenes.js",
        "core/app.js",
        "chrome/content.js"
      ]
    }
  ]
}
